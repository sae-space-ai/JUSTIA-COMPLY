# JUSTIA COMPLY — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ============ APPLICATION ============
VITE_APP_NAME=JUSTIA COMPLY
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# ============ AI COPILOT (Optional) ============
# If not configured, AI features gracefully degrade (no simulated responses).
# Supported providers: openai (more to be added)
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# ============ VERCEL DEPLOYMENT ============
# These are set automatically by Vercel. Do not set manually.
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_BRANCH_URL=

# ============ INTEGRATIONS (Future) ============
# VITE_GITHUB_APP_ID=
# VITE_WEBHOOK_SECRET=

# ============ SECURITY ============
# Rate limiting (requests per minute per user)
VITE_RATE_LIMIT_RPM=60
# Session timeout (minutes)
VITE_SESSION_TIMEOUT=30
